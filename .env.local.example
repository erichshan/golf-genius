# Golf Genius API Configuration
# Copy this file to .env.local and fill in your actual values

# Golf Genius API Key
# Obtain this from Golf Genius Support
GOLF_GENIUS_API_KEY=your_api_key_here

# Optional: Environment-specific keys
# GOLF_GENIUS_DEV_API_KEY=your_dev_api_key
# GOLF_GENIUS_PROD_API_KEY=your_prod_api_key
