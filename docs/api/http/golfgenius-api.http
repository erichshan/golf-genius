### Golf Genius API v2 - HTTP Client Requests
### IntelliJ IDEA / WebStorm HTTP Client
### Environment variables: {{host}}, {{api_key}}

##############################################################################
### SEASONS
##############################################################################

### List All Seasons
# @name listSeasons
GET {{host}}/api_v2/{{api_key}}/seasons
Accept: application/json

##############################################################################
### CATEGORIES
##############################################################################

### List All Categories
# @name listCategories
GET {{host}}/api_v2/{{api_key}}/categories
Accept: application/json

##############################################################################
### DIRECTORIES
##############################################################################

### List All Directories
# @name listDirectories
GET {{host}}/api_v2/{{api_key}}/directories
Accept: application/json

##############################################################################
### MASTER ROSTER
##############################################################################

### List All Players in Master Roster
# @name listMasterRoster
GET {{host}}/api_v2/{{api_key}}/master_roster
Accept: application/json

### List All Players in Master Roster (with pagination and photos)
# @name listMasterRosterWithOptions
GET {{host}}/api_v2/{{api_key}}/master_roster?page=1&photo=true
Accept: application/json

### Get Member by Email
# @name getMasterRosterMember
GET {{host}}/api_v2/{{api_key}}/master_roster_member/john@doe.com
Accept: application/json

##############################################################################
### PLAYERS
##############################################################################

### Get Player Events
# @name getPlayerEvents
GET {{host}}/api_v2/{{api_key}}/players/{{player_id}}
Accept: application/json

##############################################################################
### EVENTS - READ OPERATIONS
##############################################################################

### List All Events
# @name listEvents
GET {{host}}/api_v2/{{api_key}}/events
Accept: application/json

### List Events with filters
# @name listEventsFiltered
GET {{host}}/api_v2/{{api_key}}/events?page=1&season={{season_id}}&category={{category_id}}&archived=false
Accept: application/json

### Get Event Roster
# @name getEventRoster
GET {{host}}/api_v2/{{api_key}}/events/{{event_id}}/roster
Accept: application/json

### Get Event Roster with pagination and photos
# @name getEventRosterWithOptions
GET {{host}}/api_v2/{{api_key}}/events/{{event_id}}/roster?page=1&photo=true
Accept: application/json

##############################################################################
### EVENTS - WRITE OPERATIONS (Bearer Token)
##############################################################################

### Create an Event/League
# @name createEvent
POST {{host}}/api_v2/events
Authorization: Bearer {{api_key}}
Content-Type: application/json

{
  "name": "API-Event-Test",
  "external_id": "123",
  "event_type": "event",
  "external_event_type": "regular",
  "dates": {
    "1": {
      "date": "2024-09-21",
      "name": "Round 1",
      "enable_mobile_score_entry": true,
      "attending_by_default": true
    }
  }
}

### Update an Event/League
# @name updateEvent
PUT {{host}}/api_v2/events/{{event_id}}
Authorization: Bearer {{api_key}}
Content-Type: application/json

{
  "name": "API-Event-Updated",
  "external_id": "123-updated"
}

### Delete/Archive an Event/League
# @name deleteEvent
DELETE {{host}}/api_v2/events/{{event_id}}
Authorization: Bearer {{api_key}}
Content-Type: application/json

{
  "archive": false
}

##############################################################################
### ROUNDS - READ OPERATIONS
##############################################################################

### List All Event Rounds
# @name listEventRounds
GET {{host}}/api_v2/{{api_key}}/events/{{event_id}}/rounds
Accept: application/json

##############################################################################
### ROUNDS - WRITE OPERATIONS (Bearer Token)
##############################################################################

### Create an Event Round
# @name createRound
POST {{host}}/api_v2/events/{{event_id}}/rounds
Authorization: Bearer {{api_key}}
Content-Type: application/json

{
  "name": "Round Test",
  "date": "2024-09-23",
  "enable_mobile_score_entry": true,
  "attending_by_default": true,
  "show_pairings_in_league_portal": true
}

### Update an Event Round
# @name updateRound
PUT {{host}}/api_v2/events/{{event_id}}/rounds/{{round_id}}
Authorization: Bearer {{api_key}}
Content-Type: application/json

{
  "name": "Round Test Updated",
  "enable_mobile_score_entry": true
}

### Delete an Event Round
# @name deleteRound
DELETE {{host}}/api_v2/events/{{event_id}}/rounds/{{round_id}}
Authorization: Bearer {{api_key}}

##############################################################################
### COURSES
##############################################################################

### List Event Courses and Tees
# @name listEventCourses
GET {{host}}/api_v2/{{api_key}}/events/{{event_id}}/courses
Accept: application/json

### Get Course Statistics
# @name getCourseStatistics
GET {{host}}/api_v2/{{api_key}}/events/{{event_id}}/courses/{{course_id}}/course_statistics
Accept: application/json

### Get Course Statistics with filters
# @name getCourseStatisticsFiltered
GET {{host}}/api_v2/{{api_key}}/events/{{event_id}}/courses/{{course_id}}/course_statistics?round_id={{round_id}}&tee_id={{tee_id}}
Accept: application/json

##############################################################################
### TOURNAMENTS
##############################################################################

### List Round Tournaments
# @name listRoundTournaments
GET {{host}}/api_v2/{{api_key}}/events/{{event_id}}/rounds/{{round_id}}/tournaments
Accept: application/json

### Get Tournament Results (JSON)
# @name getTournamentResultsJson
GET {{host}}/api_v2/{{api_key}}/events/{{event_id}}/rounds/{{round_id}}/tournaments/{{tournament_id}}.json
Accept: application/json

### Get Tournament Results (HTML)
# @name getTournamentResultsHtml
GET {{host}}/api_v2/{{api_key}}/events/{{event_id}}/rounds/{{round_id}}/tournaments/{{tournament_id}}.html
Accept: text/html

### Get Tournament Results XML (General Purpose)
# @name getTournamentResultsXml
GET {{host}}/v2tournaments/{{tournament_id}}.xml
Accept: application/xml

### Get Tournament Results XML (Restricted - Individual Gross)
# @name getTournamentResultsRestrictedXml
GET {{host}}/v2tournaments/{{tournament_id}}/show_individual_gross.xml
Accept: application/xml

##############################################################################
### DIVISIONS - READ OPERATIONS
##############################################################################

### List All Event Divisions
# @name listEventDivisions
GET {{host}}/api_v2/{{api_key}}/events/{{event_id}}/divisions
Accept: application/json

##############################################################################
### DIVISIONS - WRITE OPERATIONS (Bearer Token)
##############################################################################

### Create an Event Division
# @name createDivision
POST {{host}}/api_v2/events/{{event_id}}/divisions
Authorization: Bearer {{api_key}}
Content-Type: application/json

{
  "name": "Division Test",
  "position": 0,
  "tee_times": [
    {
      "time": "8:10 AM",
      "starting_hole": 1,
      "starting_hole_label": "A"
    },
    {
      "time": "8:20 AM",
      "starting_hole": 1,
      "starting_hole_label": "A"
    }
  ]
}

### Update an Event Division
# @name updateDivision
PUT {{host}}/api_v2/events/{{event_id}}/divisions/{{division_id}}
Authorization: Bearer {{api_key}}
Content-Type: application/json

{
  "name": "Division Test Updated",
  "position": 1
}

### Delete an Event Division
# @name deleteDivision
DELETE {{host}}/api_v2/events/{{event_id}}/divisions/{{division_id}}
Authorization: Bearer {{api_key}}

##############################################################################
### MEMBERS - WRITE OPERATIONS (Bearer Token)
##############################################################################

### Create a Member Registration
# @name createMemberRegistration
POST {{host}}/api_v2/events/{{event_id}}/members
Authorization: Bearer {{api_key}}
Content-Type: application/json

{
  "external_id": "1234",
  "last_name": "Doe",
  "first_name": "John",
  "email": "john.doe@example.com",
  "gender": "M",
  "handicap_index": 5.0,
  "handicap_network_id": "12345678",
  "rounds": [
    {
      "round_id": 1694531015551658972
    }
  ],
  "custom_fields": {
    "Affiliation": "Test Golf Club"
  }
}

### Update a Member Registration
# @name updateMemberRegistration
PUT {{host}}/api_v2/events/{{event_id}}/members/{{member_id}}
Authorization: Bearer {{api_key}}
Content-Type: application/json

{
  "first_name": "John",
  "last_name": "Doe Updated",
  "handicap_index": 6.0
}

### Delete a Member Registration
# @name deleteMemberRegistration
DELETE {{host}}/api_v2/events/{{event_id}}/members/{{member_id}}
Authorization: Bearer {{api_key}}

##############################################################################
### PAIRING GROUPS (TEE SHEET) - READ OPERATIONS
##############################################################################

### Get Round Tee Sheet and Scores
# @name getRoundTeeSheet
GET {{host}}/api_v2/{{api_key}}/events/{{event_id}}/rounds/{{round_id}}/tee_sheet
Accept: application/json

### Get Round Tee Sheet with all custom fields
# @name getRoundTeeSheetWithCustomFields
GET {{host}}/api_v2/{{api_key}}/events/{{event_id}}/rounds/{{round_id}}/tee_sheet?include_all_custom_fields=true
Accept: application/json

##############################################################################
### PAIRING GROUPS (TEE SHEET) - WRITE OPERATIONS (Bearer Token)
##############################################################################

### Create a Pairing Group
# @name createPairingGroup
POST {{host}}/api_v2/events/{{event_id}}/rounds/{{round_id}}/pairing_groups
Authorization: Bearer {{api_key}}
Content-Type: application/json

{
  "players": {
    "1": {
      "external_id": "1235",
      "last_name": "Doe",
      "first_name": "Jane",
      "email": "jane.doe@example.com",
      "gender": "F",
      "handicap_index": 10.0,
      "handicap_network_id": "12345679"
    },
    "2": {
      "external_id": "1234",
      "last_name": "Doe",
      "first_name": "John",
      "email": "john.doe@example.com",
      "gender": "M",
      "handicap_index": 5.0,
      "handicap_network_id": "12345678"
    }
  },
  "tee_time": {
    "time": "8:10 AM",
    "starting_hole": 1,
    "starting_hole_label": "A"
  }
}

### Update a Pairing Group
# @name updatePairingGroup
PUT {{host}}/api_v2/events/{{event_id}}/rounds/{{round_id}}/pairing_groups/{{pairing_group_id}}
Authorization: Bearer {{api_key}}
Content-Type: application/json

{
  "tee_time": {
    "time": "8:30 AM",
    "starting_hole": 1
  }
}

### Delete a Pairing Group
# @name deletePairingGroup
DELETE {{host}}/api_v2/events/{{event_id}}/rounds/{{round_id}}/pairing_groups/{{pairing_group_id}}
Authorization: Bearer {{api_key}}

##############################################################################
### POINTS
##############################################################################

### Get Player Points Summary
# @name getPlayerPointsSummary
GET {{host}}/api_v2/{{api_key}}/events/{{event_id}}/rounds/{{round_id}}/player_points
Accept: application/json

### Get Team Points Summary
# @name getTeamPointsSummary
GET {{host}}/api_v2/{{api_key}}/events/{{event_id}}/rounds/{{round_id}}/team_points
Accept: application/json

##############################################################################
### UK HANDICAPS
##############################################################################

### List UK Handicap Rounds
# @name listUkHandicapRounds
GET {{host}}/api_v2/{{api_key}}/uk_handicaps/competitions
Accept: application/json

### Get UK Handicap Round Data (by GGID)
# @name getUkHandicapRoundDataByGgid
GET {{host}}/api_v2/{{api_key}}/uk_handicaps/competitions/display?ggid={{ggid}}
Accept: application/json

### Get UK Handicap Round Data (by ID)
# @name getUkHandicapRoundDataById
GET {{host}}/api_v2/{{api_key}}/uk_handicaps/competitions/display?id={{round_id}}
Accept: application/json

##############################################################################
### SEASON POINTS
##############################################################################

### List Season Points Categories
# @name listSeasonPointsCategories
GET {{host}}/api_v2/{{api_key}}/season_points/categories
Accept: application/json

### Get Season Points Category Players
# @name getSeasonPointsCategoryPlayers
GET {{host}}/api_v2/{{api_key}}/season_points/categories/{{category_id}}
Accept: application/json
